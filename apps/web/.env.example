NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_USDC_ADDRESS=0x
NEXT_PUBLIC_POOL_ADDRESS=0x
NEXT_PUBLIC_REGISTRY_ADDRESS=0x
NEXT_PUBLIC_CONTROLLER_ADDRESS=0x
